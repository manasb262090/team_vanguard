-- =====================================================================
-- Connect Web : Supabase (PostgreSQL) schema
-- Run in Supabase Dashboard -> SQL Editor. Auth users live in auth.users;
-- everything else below references them.
-- =====================================================================

create extension if not exists "pgcrypto";

-- ---------- ENUMS ----------
create type user_role     as enum ('student', 'teacher', 'admin');
create type verify_status as enum ('pending', 'verified', 'rejected');
create type post_kind     as enum ('post', 'announcement');

-- ---------- ACADEMIC STRUCTURE ----------
create table branches (
  id         uuid primary key default gen_random_uuid(),
  name       text not null,                 -- e.g. Computer Science
  code       text unique not null,          -- e.g. CSE
  created_at timestamptz default now()
);

-- ---------- USERS / PROFILES ----------
create table profiles (
  id            uuid primary key references auth.users(id) on delete cascade,
  role          user_role     not null default 'student',
  status        verify_status not null default 'pending',  -- admin/teacher verifies
  full_name     text not null,
  email         text not null,
  phone         text,
  enrollment_no text unique,                -- students only
  employee_id   text unique,                -- teachers/staff only
  branch_id     uuid references branches(id),
  year          int check (year between 1 and 6),
  section       text,
  avatar_url    text,
  created_at    timestamptz default now()
);

-- Auto-create profile on signup. Role is ALWAYS 'student' here;
-- only an admin can promote someone to teacher/admin.
create or replace function handle_new_user() returns trigger
language plpgsql security definer set search_path = public as $$
begin
  insert into profiles (id, full_name, email, enrollment_no, branch_id, year)
  values (
    new.id,
    coalesce(new.raw_user_meta_data->>'full_name', 'New User'),
    new.email,
    new.raw_user_meta_data->>'enrollment_no',
    nullif(new.raw_user_meta_data->>'branch_id','')::uuid,
    nullif(new.raw_user_meta_data->>'year','')::int
  );
  return new;
end $$;

create trigger on_auth_user_created
  after insert on auth.users
  for each row execute function handle_new_user();

-- Helper functions used by RLS policies
create or replace function my_role() returns user_role
language sql stable security definer set search_path = public as
$$ select role from profiles where id = auth.uid() $$;

create or replace function is_verified() returns boolean
language sql stable security definer set search_path = public as
$$ select coalesce((select status = 'verified' from profiles where id = auth.uid()), false) $$;

-- ---------- SUBJECTS, SYLLABUS, MARKS ----------
create table subjects (
  id         uuid primary key default gen_random_uuid(),
  branch_id  uuid not null references branches(id),
  semester   int  not null,
  code       text not null,
  name       text not null,
  credits    int,
  teacher_id uuid references profiles(id),
  unique (branch_id, semester, code)
);

create table syllabus_units (
  id         uuid primary key default gen_random_uuid(),
  subject_id uuid not null references subjects(id) on delete cascade,
  unit_no    int  not null,
  title      text not null,
  topics     text,
  unique (subject_id, unit_no)
);

create table marks (
  id         uuid primary key default gen_random_uuid(),
  student_id uuid not null references profiles(id) on delete cascade,
  subject_id uuid not null references subjects(id) on delete cascade,
  exam_type  text not null,                 -- internal1, internal2, midterm, final
  marks      numeric(5,2) not null,
  max_marks  numeric(5,2) not null default 100,
  entered_by uuid references profiles(id),
  created_at timestamptz default now(),
  unique (student_id, subject_id, exam_type)
);

-- Student report card view (marks per subject + percentage)
create view student_report as
select m.student_id, s.semester, s.code, s.name as subject, m.exam_type,
       m.marks, m.max_marks, round(m.marks / m.max_marks * 100, 1) as percentage
from marks m join subjects s on s.id = m.subject_id;

-- ---------- EVENTS & PARTICIPATION TRACKER ----------
create table events (
  id          uuid primary key default gen_random_uuid(),
  title       text not null,
  description text,
  category    text,                          -- hackathon, sports, cultural, workshop
  venue       text,
  starts_at   timestamptz,
  created_by  uuid references profiles(id),
  created_at  timestamptz default now()
);

create table event_participants (
  id              uuid primary key default gen_random_uuid(),
  event_id        uuid not null references events(id) on delete cascade,
  student_id      uuid not null references profiles(id) on delete cascade,
  position        text,                      -- winner, runner-up, participant
  certificate_url text,                      -- uploaded proof
  status          verify_status not null default 'pending',
  verified_by     uuid references profiles(id),
  verified_at     timestamptz,
  file_hash       text,                      -- sha-256 of certificate (duplicate/fake check)
  created_at      timestamptz default now(),
  unique (event_id, student_id)
);

-- Live participation count per event (verified only)
create view event_stats as
select e.id as event_id, e.title,
       count(*) filter (where p.status = 'verified') as verified_count,
       count(*) filter (where p.status = 'pending')  as pending_count,
       count(*)                                      as total_registered
from events e left join event_participants p on p.event_id = e.id
group by e.id, e.title;

-- ---------- STAFF & IMPORTANT CONTACTS ----------
create table staff_directory (
  id          uuid primary key default gen_random_uuid(),
  full_name   text not null,
  designation text not null,                 -- Principal, HOD CSE, Exam Cell, Librarian
  department  text,
  phone       text,
  email       text,
  office_room text,
  photo_url   text,
  sort_order  int default 100
);

-- ---------- ASSIGNMENTS & DOCUMENTS ----------
create table assignments (
  id          uuid primary key default gen_random_uuid(),
  subject_id  uuid not null references subjects(id) on delete cascade,
  title       text not null,
  description text,
  due_at      timestamptz,
  created_by  uuid references profiles(id),
  created_at  timestamptz default now()
);

create table submissions (
  id            uuid primary key default gen_random_uuid(),
  assignment_id uuid not null references assignments(id) on delete cascade,
  student_id    uuid not null references profiles(id) on delete cascade,
  file_url      text not null,               -- Supabase Storage path
  note          text,
  grade         numeric(5,2),
  feedback      text,
  submitted_at  timestamptz default now(),
  unique (assignment_id, student_id)
);

create table documents (                       -- bonafide, ID proof, fee receipt, etc.
  id          uuid primary key default gen_random_uuid(),
  owner_id    uuid not null references profiles(id) on delete cascade,
  doc_type    text not null,
  file_url    text not null,
  status      verify_status not null default 'pending',
  reviewed_by uuid references profiles(id),
  created_at  timestamptz default now()
);

-- ---------- CAMPUS FEED (Threads-style) ----------
create table groups (                          -- branch/year group, also club groups
  id         uuid primary key default gen_random_uuid(),
  name       text not null,                    -- "CSE 3rd Year"
  branch_id  uuid references branches(id),
  year       int,
  created_at timestamptz default now()
);

create table group_members (
  group_id uuid references groups(id) on delete cascade,
  user_id  uuid references profiles(id) on delete cascade,
  primary key (group_id, user_id)
);

create table posts (
  id         uuid primary key default gen_random_uuid(),
  author_id  uuid not null references profiles(id) on delete cascade,
  group_id   uuid references groups(id) on delete cascade,  -- null = whole campus feed
  parent_id  uuid references posts(id) on delete cascade,   -- reply thread
  kind       post_kind not null default 'post',             -- announcement: teachers/admin only
  body       text not null check (char_length(body) <= 1000),
  image_url  text,
  created_at timestamptz default now()
);

create table post_likes (
  post_id uuid references posts(id) on delete cascade,
  user_id uuid references profiles(id) on delete cascade,
  primary key (post_id, user_id)
);

create index on posts (group_id, created_at desc);
create index on posts (parent_id);
create index on event_participants (student_id);
create index on marks (student_id);
create index on submissions (assignment_id);

-- =====================================================================
-- ROW LEVEL SECURITY
-- =====================================================================
alter table profiles           enable row level security;
alter table branches           enable row level security;
alter table subjects           enable row level security;
alter table syllabus_units     enable row level security;
alter table marks              enable row level security;
alter table events             enable row level security;
alter table event_participants enable row level security;
alter table staff_directory    enable row level security;
alter table assignments        enable row level security;
alter table submissions        enable row level security;
alter table documents          enable row level security;
alter table groups             enable row level security;
alter table group_members      enable row level security;
alter table posts              enable row level security;
alter table post_likes         enable row level security;

-- profiles: see yourself; teachers/admins see everyone; only admin edits role/status
create policy profiles_read on profiles for select
  using (id = auth.uid() or my_role() in ('teacher','admin'));
create policy profiles_update_self on profiles for update
  using (id = auth.uid())
  with check (id = auth.uid() and role = (select role from profiles where id = auth.uid())
                              and status = (select status from profiles where id = auth.uid()));
create policy profiles_admin_all on profiles for all
  using (my_role() = 'admin') with check (my_role() = 'admin');

-- public-read reference data (verified users only)
create policy branches_read  on branches          for select using (is_verified());
create policy subjects_read  on subjects          for select using (is_verified());
create policy syllabus_read  on syllabus_units    for select using (is_verified());
create policy events_read    on events            for select using (is_verified());
create policy staff_read     on staff_directory   for select using (is_verified());
create policy groups_read    on groups            for select using (is_verified());

-- write access: teachers/admin manage academic data
create policy subjects_write on subjects       for all using (my_role() in ('teacher','admin')) with check (my_role() in ('teacher','admin'));
create policy syllabus_write on syllabus_units for all using (my_role() in ('teacher','admin')) with check (my_role() in ('teacher','admin'));
create policy events_write   on events         for all using (my_role() in ('teacher','admin')) with check (my_role() in ('teacher','admin'));
create policy staff_write    on staff_directory for all using (my_role() = 'admin') with check (my_role() = 'admin');
create policy branches_write on branches       for all using (my_role() = 'admin') with check (my_role() = 'admin');
create policy groups_write   on groups         for all using (my_role() in ('teacher','admin')) with check (my_role() in ('teacher','admin'));

-- marks: student sees own, teachers/admin see and enter all
create policy marks_read  on marks for select using (student_id = auth.uid() or my_role() in ('teacher','admin'));
create policy marks_write on marks for all    using (my_role() in ('teacher','admin')) with check (my_role() in ('teacher','admin'));

-- event participation: students submit own, teachers/admin verify
create policy ep_read   on event_participants for select using (student_id = auth.uid() or my_role() in ('teacher','admin'));
create policy ep_insert on event_participants for insert with check (student_id = auth.uid() and is_verified());
create policy ep_verify on event_participants for update using (my_role() in ('teacher','admin'));

-- assignments & submissions
create policy asg_read  on assignments for select using (is_verified());
create policy asg_write on assignments for all    using (my_role() in ('teacher','admin')) with check (my_role() in ('teacher','admin'));
create policy sub_read  on submissions for select using (student_id = auth.uid() or my_role() in ('teacher','admin'));
create policy sub_write on submissions for insert with check (student_id = auth.uid() and is_verified());
create policy sub_grade on submissions for update using (my_role() in ('teacher','admin'));

-- documents: owner + teachers/admin
create policy doc_read   on documents for select using (owner_id = auth.uid() or my_role() in ('teacher','admin'));
create policy doc_insert on documents for insert with check (owner_id = auth.uid());
create policy doc_review on documents for update using (my_role() in ('teacher','admin'));

-- group membership and feed
create policy gm_read   on group_members for select using (is_verified());
create policy gm_write  on group_members for all using (my_role() in ('teacher','admin')) with check (my_role() in ('teacher','admin'));
create policy posts_read   on posts for select using (is_verified());
create policy posts_insert on posts for insert with check (
  author_id = auth.uid() and is_verified()
  and (kind = 'post' or my_role() in ('teacher','admin'))   -- announcements: staff only
);
create policy posts_delete on posts for delete using (author_id = auth.uid() or my_role() in ('teacher','admin'));
create policy likes_read  on post_likes for select using (is_verified());
create policy likes_write on post_likes for all using (user_id = auth.uid()) with check (user_id = auth.uid());

